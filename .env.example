# FLASHWEAR Environment Variables Example
# Duplicate this file to .env.local and fill in your values.

# Supabase Public Configuration (Safe for Browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Secret Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Required for server-side order transactions and elevated administrative operations
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site URL Configuration (Used for canonical URLs, metadata and links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional Email (Optional - Provider: Resend)
# If omitted or invalid, COD orders continue seamlessly without email dispatch
RESEND_API_KEY=
STORE_FROM_EMAIL=orders@flashwear.store
ADMIN_NOTIFICATION_EMAIL=admin@flashwear.store
