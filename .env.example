# FLASHWEAR Environment Variables Example
# Duplicate this file to .env.local and fill in your values.

# 1. Supabase Public Configuration (Safe for Browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Supabase Secret Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Required for server-side order transactions and elevated administrative operations
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 3. Site URL Configuration (Used for canonical URLs, metadata, links, and SSLCOMMERZ callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 4. SSLCOMMERZ Online Payment Gateway (Phase 2)
# Official Docs: https://developer.sslcommerz.com/doc/v4/index.html
# Leave empty to test with high-fidelity built-in sandbox mock harness
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# Set to 'false' in production for live payments on securepay.sslcommerz.com
SSLCOMMERZ_IS_SANDBOX=true

# 5. Pathao Courier Logistics API (Phase 2)
# Official Docs: https://pathao.com/courier/
# Leave empty to use manual tracking & dispatch fallback mode
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
PATHAO_IS_SANDBOX=true

# 6. Transactional Email (Optional - Provider: Resend)
# If omitted, orders and status transitions continue seamlessly with in-app notifications
RESEND_API_KEY=
STORE_FROM_EMAIL=orders@flashwear.store
ADMIN_NOTIFICATION_EMAIL=admin@flashwear.store
MARKETING_EMAIL_FROM=drops@flashwear.store

# 7. Production Gateway Safety (Phase 3)
# When NODE_ENV === 'production', the built-in mock gateway is strictly blocked unless this is set to 'true'.
ENABLE_MOCK_PAYMENT_GATEWAY=false

# 8. Scheduled Automated Jobs & Cron Security (Phase 3)
# Bearer token required to trigger /api/cron/abandoned-carts from Vercel Cron or GitHub Actions
CRON_SECRET=your-secure-cron-secret-token

# 9. Advanced E-commerce Analytics (Phase 3)
# Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# 10. Production Observability & Error Monitoring (Phase 4)
# Sentry DSN for unhandled exceptions and performance tracing
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# 11. Distributed Rate Limiting (Phase 4 - Optional)
# Upstash Redis REST credentials for multi-instance rate limiting.
# If omitted, local in-memory sliding window limiter is automatically used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 12. Administration & Deployment Release (Phase 4)
ADMIN_SECRET_KEY=
NEXT_PUBLIC_APP_VERSION=1.0.0

